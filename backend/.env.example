# 🎓 LEARNING: These are the "slots" we need to fill with real values

# Supabase Configuration (PostgreSQL database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# MongoDB Configuration (Document database)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_DATABASE=nexium_blog_db

# Application Settings (how our app behaves)
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

